+/**
+ * Quiet mode (-Q) omits token lines from stdout. Hermes stores cumulative session
+ * totals in the session store — export them so Paperclip can ledger per-run deltas.
+ */
+async function fetchHermesSessionUsage(hermesCmd, sessionId, onLog) {
+    try {
+        const exportRun = await runChildProcess(`hermes-export-${sessionId}`, hermesCmd, [
+            "sessions",
+            "export",
+            "-",
+            "--session-id",
+            sessionId,
+        ], {
+            timeoutSec: 45,
+            onLog: async () => { },
+        });
+        const stdout = exportRun.stdout || "";
+        for (const line of stdout.split("\n")) {
+            const trimmed = line.trim();
+            if (!trimmed)
+                continue;
+            try {
+                const row = JSON.parse(trimmed);
+                if (row.id !== sessionId)
+                    continue;
+                if (typeof row.input_tokens !== "number" && typeof row.output_tokens !== "number") {
+                    continue;
+                }
+                const inputTokens = Math.max(0, Math.floor(row.input_tokens ?? 0));
+                const outputTokens = Math.max(0, Math.floor(row.output_tokens ?? 0));
+                const cachedInputTokens = Math.max(0, Math.floor((row.cache_read_tokens ?? 0) + (row.cache_write_tokens ?? 0)));
+                if (inputTokens <= 0 && outputTokens <= 0 && cachedInputTokens <= 0) {
+                    return null;
+                }
+                return { inputTokens, outputTokens, cachedInputTokens };
+            }
+            catch {
+                // skip non-JSON lines
+            }
+        }
+    }
+    catch (err) {
+        const message = err instanceof Error ? err.message : String(err);
+        await onLog("stdout", `[hermes] Session usage export failed: ${message}\n`);
+    }
+    return null;
+}
